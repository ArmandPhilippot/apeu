{
  "name": "apeu",
  "description": "The code source of my personal website.",
  "version": "2.3.0",
  "license": "MIT",
  "author": {
    "name": "Armand Philippot",
    "email": "git@armand.philippot.eu",
    "url": "https://armand.philippot.eu/"
  },
  "homepage": "https://github.com/ArmandPhilippot/apeu#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:ArmandPhilippot/apeu.git"
  },
  "bugs": {
    "url": "https://github.com/ArmandPhilippot/apeu/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": ">=12.0.0 <13.0.0"
    }
  },
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build",
    "build:e2e": "astro build --devOutput",
    "ci:release": "changeset publish",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "dev": "astro dev",
    "fix": "pnpm run \"/^fix:.*/\"",
    "fix:formatting": "prettier . --write",
    "fix:scripts": "eslint --fix .",
    "fix:styles": "stylelint --fix \"src/**/*.{astro,css,scss}\"",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:formatting": "prettier . --check",
    "lint:scripts": "eslint .",
    "lint:spelling": "cspell \"**\" --no-progress",
    "lint:styles": "stylelint \"src/**/*.{astro,css,scss}\"",
    "lint:types": "astro check",
    "prepare": "husky",
    "preview": "astro preview",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm build:e2e && pnpm test:e2e:run",
    "test:e2e:install": "pnpm exec playwright install chromium",
    "test:e2e:run": "pnpm exec playwright test",
    "test:e2e:ui": "pnpm build:e2e && pnpm exec playwright test --ui",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest watch",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/node": "^11.1.8",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@nanostores/persistent": "^1.3.5",
    "@pagefind/default-ui": "^1.5.2",
    "@rolldown/pluginutils": "^1.0.1",
    "astro": "^7.4.0",
    "astro-icon": "^1.2.0",
    "is-relative-url": "^4.1.1",
    "mdast-util-to-nlcst": "^7.0.1",
    "modern-normalize": "^3.0.1",
    "nanostores": "^1.5.5",
    "nodemailer": "^10.1.1",
    "pagefind": "^1.5.2",
    "parse-english": "^7.0.0",
    "parse-latin": "^7.0.0",
    "satori-astro": "^0.4.0",
    "satori-html": "^0.3.2",
    "satteri": "^0.10.5",
    "sharp": "^0.35.5",
    "sharp-ico": "^0.1.5",
    "shiki": "^4.5.0",
    "sirv": "^3.0.2",
    "slash": "^5.1.0",
    "tinyglobby": "^0.2.17",
    "ultrahtml": "^1.7.0",
    "vfile": "^6.0.3",
    "vite": "^8.3.4",
    "zod-form-data": "^3.0.4"
  },
  "devDependencies": {
    "@arphi/commitlint-config": "^1.0.10",
    "@arphi/eslint-config": "^3.1.0",
    "@arphi/prettier-config": "^1.0.5",
    "@arphi/stylelint-config": "2.0.1",
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@csstools/postcss-global-data": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/mailparser": "^3.9.0",
    "@types/mdast": "^4.0.4",
    "@types/nlcst": "^2.0.3",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/web-app-manifest": "^1.0.9",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^5.0.5",
    "astro-eslint-parser": "^3.2.0",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.29",
    "cspell": "^10.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "mailparser": "^3.9.39",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "^11.6.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "schema-dts": "^2.1.0",
    "smtp-server": "^3.19.22",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
